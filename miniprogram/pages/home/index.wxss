.home {
  padding-top: 20rpx;
}

.home-top {
  margin-bottom: 24rpx;
}

.brand-line {
  display: flex;
  align-items: center;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-right: 12rpx;
  border-radius: 15rpx;
  color: #fff;
  background: #17664f;
  font-size: 29rpx;
  font-weight: 700;
}

.brand-name {
  font-size: 32rpx;
  font-weight: 700;
}

.location {
  margin: 8rpx 0 0 64rpx;
  color: #63716a;
  font-size: 24rpx;
}

.hero {
  padding: 30rpx 26rpx 25rpx;
  border-radius: 22rpx;
  color: #fff;
  background: #215c4c;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-copy {
  margin: 12rpx 0 21rpx;
  color: #d7e6df;
  font-size: 25rpx;
  line-height: 1.5;
}

.search-box {
  display: flex;
  align-items: center;
  min-height: 86rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  color: #66736d;
  background: #fff;
}

.search-box input {
  flex: 1;
  height: 84rpx;
  margin-left: 18rpx;
  font-size: 27rpx;
}

.search-mark {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #748079;
  border-radius: 50%;
}

.search-mark::after {
  position: absolute;
  right: -9rpx;
  bottom: -5rpx;
  width: 12rpx;
  height: 3rpx;
  background: #748079;
  content: "";
  transform: rotate(45deg);
}

.small {
  font-size: 26rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.category {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 140rpx;
  margin: 0;
  padding: 12rpx 4rpx;
  border: 1rpx solid #e0e6e1;
  border-radius: 15rpx;
  color: #33423b;
  background: #fff;
  font-size: 26rpx;
  line-height: 1.3;
}

.category::after {
  border: 0;
}

.category-active {
  border-color: #8db5a0;
  color: #245c47;
  background: #eaf3ed;
}

.category-symbol {
  display: grid;
  place-items: center;
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 9rpx;
  border-radius: 50%;
  color: #215c4c;
  background: #e3eee7;
  font-size: 25rpx;
  font-weight: 700;
}

.notice {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.notice-title {
  color: #765524;
  font-weight: 700;
}

.provider-card {
  display: flex;
  gap: 17rpx;
  margin-bottom: 14rpx;
  padding: 17rpx;
  border: 1rpx solid #e0e6e1;
  border-radius: 15rpx;
  background: #fff;
}

.provider-art {
  position: relative;
  flex: none;
  width: 140rpx;
  height: 140rpx;
  overflow: hidden;
  border-radius: 13rpx;
  background: #dce9df;
}

.provider-art-b {
  background: #e9e3d5;
}

.art-sun {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 31rpx;
  height: 31rpx;
  border-radius: 50%;
  background: #f2bd76;
}

.art-hill {
  position: absolute;
  bottom: -23rpx;
  left: -14rpx;
  width: 180rpx;
  height: 95rpx;
  border-radius: 50% 50% 0 0;
  background: #6f9a78;
}

.art-hill::after {
  position: absolute;
  right: -55rpx;
  bottom: 13rpx;
  width: 145rpx;
  height: 78rpx;
  border-radius: 50% 50% 0 0;
  background: #8eaf91;
  content: "";
}

.provider-art-b .art-hill {
  background: #b88d65;
}

.provider-art-b .art-hill::after {
  background: #d0ac7d;
}

.provider-content {
  flex: 1;
  min-width: 0;
}

.provider-heading {
  align-items: flex-start;
  gap: 8rpx;
}

.provider-name {
  flex: 1;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.provider-price {
  color: #bd593f;
  white-space: nowrap;
  font-size: 26rpx;
  font-weight: 700;
}

.per {
  font-size: 24rpx;
  font-weight: 400;
}

.provider-description {
  margin-top: 6rpx;
  color: #63716a;
  font-size: 26rpx;
  line-height: 1.4;
}

.verify-tag {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 5rpx 9rpx;
  border-radius: 6rpx;
  color: #245c47;
  background: #e6f1eb;
  font-size: 24rpx;
}

.empty-state {
  padding: 35rpx 18rpx;
  color: #63716a;
  text-align: center;
  font-size: 26rpx;
}

.publish-cta {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}
