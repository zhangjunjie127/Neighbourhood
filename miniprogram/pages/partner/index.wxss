.page-title {
  font-size: 40rpx;
  font-weight: 700;
}

.intro {
  margin-top: 8rpx;
}

.role-switch {
  display: flex;
  gap: 8rpx;
  margin: 22rpx 0;
  padding: 6rpx;
  border: 1rpx solid #e0e6e1;
  border-radius: 13rpx;
  background: #fff;
}

.role-button {
  flex: 1;
  min-height: 76rpx;
  margin: 0;
  border-radius: 9rpx;
  color: #63716a;
  background: transparent;
  font-size: 26rpx;
}

.role-button::after {
  border: 0;
}

.role-active {
  color: #fff;
  background: #17664f;
}

.card-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value text {
  color: #63716a;
}

.status-tag {
  padding: 8rpx 11rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.status-pending {
  color: #765524;
  background: #fff4dd;
}

.status-approved {
  color: #245c47;
  background: #e6f1eb;
}

.detail-line {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-top: 1rpx solid #edf0ed;
  font-size: 25rpx;
}

.detail-line text:first-child {
  color: #63716a;
}

.review-actions {
  margin-top: 16rpx;
}

.pending-copy,
.approved-copy {
  margin-top: 16rpx;
}

.approved-copy {
  color: #245c47;
  font-size: 25rpx;
}

.event-row {
  display: flex;
  gap: 14rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid #edf0ed;
  font-size: 25rpx;
}

.event-dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  margin-top: 9rpx;
  border: 3rpx solid #76a38c;
  border-radius: 50%;
}

.event-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
}
